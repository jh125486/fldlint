package flags

import (
	"context"

	"github.com/launchdarkly/go-server-sdk/v7"
	"github.com/open-feature/go-sdk/openfeature"
)

var client = openfeature.NewClient("pricing")

var ldClient *ldclient.LDClient

func DiscountRate(userKey string) float64 {
	rate, _ := client.FloatValue(context.TODO(), "discount-rate", 0.1, openfeature.NewEvaluationContext(userKey, nil))
	return rate
}
