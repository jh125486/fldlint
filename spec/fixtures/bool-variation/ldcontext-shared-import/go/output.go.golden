package flags

import (
	"context"

	"github.com/launchdarkly/go-server-sdk/v7"
	"github.com/open-feature/go-sdk/openfeature"
)

var client = openfeature.NewClient("shop")

var ldClient *ldclient.LDClient

func CheckoutEnabled() bool {
	on, _ := client.BooleanValue(context.TODO(), "new-checkout", false, openfeature.NewEvaluationContext("user", nil))
	return on
}

func SearchEnabled() bool {
	on, _ := client.BooleanValue(context.TODO(), "new-search", false, openfeature.NewEvaluationContext("user", nil))
	return on
}
