package flags

import (
	"context"
	"fmt"
	"time"

	"github.com/launchdarkly/go-server-sdk/v7"
	"github.com/open-feature/go-sdk/openfeature"
)

var client = openfeature.NewClient("checkout")

func CheckoutEnabled() bool {
	ldClient, err := ldclient.MakeClient("sdk-key", 5*time.Second)
	if err != nil {
		return false
	}
	defer ldClient.Close()
	enabled, err := client.BooleanValue(context.TODO(), "new-checkout", false, openfeature.NewEvaluationContext("user", nil))
	if err != nil {
		fmt.Println("flag error:", err)
	}
	return enabled
}
