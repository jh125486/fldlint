package flags

import (
	"context"

	"github.com/launchdarkly/go-server-sdk/v7"
	"github.com/open-feature/go-sdk/openfeature"
)

var client = openfeature.NewClient("banner")

var ldClient *ldclient.LDClient

func BannerEnabled(userKey string) bool {
	on, _ := client.BooleanValue(context.TODO(), "promo" /* flag */, false /* off */, /* who */ openfeature.NewEvaluationContext(userKey, nil))
	return on
}
