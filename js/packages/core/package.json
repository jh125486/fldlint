{
  "name": "@fldlint/core",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jh125486/fldlint.git",
    "directory": "js/packages/core"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "prebuild": "npm run build -w @fldlint/spec --silent",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm run build -w @fldlint/spec --silent",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "npm run build -w @fldlint/spec --silent",
    "test": "vitest run"
  },
  "dependencies": {
    "@fldlint/spec": "0.0.0",
    "@typescript-eslint/parser": "8.74.0",
    "@typescript-eslint/utils": "8.74.0",
    "@typescript-eslint/visitor-keys": "8.74.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "eslint": "^10.15.0",
    "fast-check": "^4.0.0"
  }
}
