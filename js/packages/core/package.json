{
  "name": "@fldlint/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "npm run build -w @fldlint/spec --silent",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm run build -w @fldlint/spec --silent",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "npm run build -w @fldlint/spec --silent",
    "test": "vitest run"
  },
  "dependencies": {
    "@fldlint/spec": "0.0.0",
    "@typescript-eslint/parser": "8.74.0",
    "@typescript-eslint/utils": "8.73.0",
    "@typescript-eslint/visitor-keys": "8.74.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "eslint": "^10.15.0",
    "fast-check": "^4.0.0"
  }
}
