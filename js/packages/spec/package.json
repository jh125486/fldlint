{
  "name": "@fldlint/spec",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jh125486/fldlint.git",
    "directory": "js/packages/spec"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "testdata"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "gen": "tsc -p tsconfig.build.json && node dist/bin/gen.js && tsc -p tsconfig.build.json",
    "spec:validate": "tsc -p tsconfig.build.json && node dist/bin/validate.js",
    "spec:tags": "tsc -p tsconfig.build.json && node dist/bin/tags.js"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0"
  }
}
