{
  "name": "fldlint-js",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint:eslint": "npm run build --silent && eslint .",
    "lint": "npm run typecheck && npm run lint:eslint",
    "gen": "npm run gen -w @fldlint/spec",
    "spec:validate": "npm run build -w @fldlint/spec --silent && node packages/spec/dist/bin/validate.js",
    "spec:tags": "npm run build -w @fldlint/spec --silent && node packages/spec/dist/bin/tags.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.10",
    "eslint": "^10.15.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "^5.1.1"
  }
}
