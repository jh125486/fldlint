{
  "name": "fldlint-js",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run typecheck",
    "gen": "npm run gen -w @fldlint/spec",
    "spec:validate": "npm run build -w @fldlint/spec --silent && node packages/spec/dist/bin/validate.js",
    "spec:tags": "npm run build -w @fldlint/spec --silent && node packages/spec/dist/bin/tags.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
