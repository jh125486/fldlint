package pkgrecv

import (
	"context"

	"github.com/open-feature/go-sdk/openfeature"
)

var client = openfeature.NewClient("pkgrecv")

func Enabled() bool {
	on, _ := client.BooleanValue(context.TODO(), "pkg", false, openfeature.NewEvaluationContext("u", nil)) // want `Migrate boolean flag "pkg" to OpenFeature`
	return on
}
