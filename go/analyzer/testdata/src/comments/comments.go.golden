package comments

import (
	"context"

	"github.com/launchdarkly/go-server-sdk/v7"
	"github.com/open-feature/go-sdk/openfeature"
)

var client = openfeature.NewClient("comments")

var ldClient *ldclient.LDClient

func Inline(userKey string) bool {
	on, _ := client.BooleanValue(context.TODO(), "a" /* flag */, false /* off */, /* who */ openfeature.NewEvaluationContext(userKey, nil)) // want `Migrate boolean flag "a" to OpenFeature`
	return on
}

func Lines(userKey string) bool {
	/* want `Migrate boolean flag "b" to OpenFeature` */ on, _ := client.BooleanValue(context.TODO(), "b", // the flag
		false, // default
		openfeature.NewEvaluationContext(userKey, nil), // who
	)
	return on
}

func Hoisted(userKey string) bool {
	on, _ := /* x */ /* y */ /* z */ client.BooleanValue(context.TODO(), "c", false, openfeature.NewEvaluationContext(userKey, nil)) // want `Migrate boolean flag "c" to OpenFeature`
	return on
}

func OwnLine(userKey string) bool {
	/* want `Migrate boolean flag "d" to OpenFeature` */ on, _ := client.BooleanValue(context.TODO(), // which flag
		"d", false, openfeature.NewEvaluationContext(userKey, nil), // end
	)
	return on
}

func Verbatim(userKey string) bool {
	on, _ := client.BooleanValue(context.TODO(), "e", false, openfeature.NewEvaluationContext(string(/* kept with the key */ userKey), nil)) // want `Migrate boolean flag "e" to OpenFeature`
	return on
}

func WithContext(ctx context.Context, userKey string) bool {
	on, _ := client.BooleanValue(ctx /* c */, /* flag */ "f", false, openfeature.NewEvaluationContext(userKey, nil)) // want `Migrate boolean flag "f" to OpenFeature`
	return on
}
