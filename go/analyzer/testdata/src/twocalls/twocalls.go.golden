package twocalls

import (
	"context"
	"fmt"

	"github.com/launchdarkly/go-server-sdk/v7"
	"github.com/open-feature/go-sdk/openfeature"
)

var client = openfeature.NewClient("two")

var ld *ldclient.LDClient

func Both(userKey string) (bool, string) {
	on, _ := client.BooleanValue(context.TODO(), "a", false, openfeature.NewEvaluationContext(userKey, nil))    // want `Migrate boolean flag "a" to OpenFeature`
	s, _ := client.StringValue(context.TODO(), "b", "fallback", openfeature.NewEvaluationContext(userKey, nil)) // want `Migrate string flag "b" to OpenFeature`
	fmt.Println(on, s)
	return on, s
}
