package addctx

import (
	"context"

	"github.com/launchdarkly/go-server-sdk/v7"
	"github.com/open-feature/go-sdk/openfeature"
)

var client = openfeature.NewClient("addctx")

var ld *ldclient.LDClient

func Enabled(userKey string) bool {
	on, _ := client.BooleanValue(context.TODO(), "new-ui", false, openfeature.NewEvaluationContext(userKey, nil)) // want `Migrate boolean flag "new-ui" to OpenFeature`
	return on
}
