{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "fldlint",
          "version": "1.2.3",
          "rules": [
            {
              "id": "bool-variation"
            }
          ]
        }
      },
      "columnKind": "utf16CodeUnits",
      "results": [
        {
          "ruleId": "bool-variation",
          "level": "error",
          "message": {
            "text": "Flag key is not a static string"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "dyn/dyn.go",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 14,
                  "startColumn": 11
                }
              }
            }
          ],
          "partialFingerprints": {
            "fldlint/fingerprint": "39f31588c2964c6ada7c1b900eacef1d"
          },
          "baselineState": "new",
          "properties": {
            "risk": "low",
            "skip": "dynamic-key"
          }
        },
        {
          "ruleId": "bool-variation",
          "level": "error",
          "message": {
            "text": "Migrate boolean flag \"cafe-menu\" to OpenFeature"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "flags/input.go",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 20,
                  "startColumn": 32
                }
              }
            }
          ],
          "partialFingerprints": {
            "fldlint/fingerprint": "87978fb58d6fc554876accf055a31851"
          },
          "baselineState": "unchanged",
          "properties": {
            "risk": "low"
          }
        }
      ]
    }
  ]
}
